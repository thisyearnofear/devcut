# ----------------------------------------------------------------------------
# Director's Canvas — single source of truth for all env vars
# Copy: cp .env.example .env   (one file, all services read from it)
# The agent reads .env via a symlink: apps/agent/.env -> ../../.env
# deploy.sh creates this symlink automatically.
# ----------------------------------------------------------------------------

# Domain — used to derive public WebSocket URL and CORS origins.
# Set to your production domain; leave as localhost for local dev.
DOMAIN=localhost

# Gemini Flash-Lite is the default model. Required for chat to work.
# Get a key: https://aistudio.google.com → Get API key (starts with AIza)
# The "stub-..." placeholder lets the agent boot for local dev; chat will fail
# with an opaque auth error until you replace it with a real key.
GEMINI_API_KEY=stub-replace-with-real-key-from-aistudio-google-com

# Agent runtime — pick which model + planner combo runs the agent.
# Options: gemini-flash-deep | gemini-flash-react | claude-sonnet-4-6-react
# See README → "Switching to a different model" for runtime details.
AGENT_RUNTIME=gemini-flash-deep

# Anthropic key — only needed if AGENT_RUNTIME=claude-sonnet-4-6-react.
# ANTHROPIC_API_KEY=

# CopilotKit license — run `npm run license` to get one (or use the CLI flow)
COPILOTKIT_LICENSE_TOKEN=

# Intelligence (threads) — match the host port remaps below
INTELLIGENCE_API_URL=http://localhost:4203
INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4403
INTELLIGENCE_API_KEY=cpk_sPRVSEED_seed0privat0longtoken00

# Host port remaps for the Intelligence Docker stack.
# Defaults avoid colliding with other local Intelligence stacks (which use
# 5432 / 6379 / 4201 / 4401). To use the originals, change these to the
# defaults — no other code change needed.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6381
APP_API_HOST_PORT=4203
REALTIME_GATEWAY_HOST_PORT=4403

# LangGraph deep-agent (Python, port 8123)
LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123

# MCP server (mcp-use, port 3011)
MCP_SERVER_URL=http://localhost:3011/mcp

# CopilotKit BFF (Hono runtime). Override only if you move the BFF off :4010.
BFF_URL=http://localhost:4010

# Per-thread Runway credit budget (USD). Prevents runaway spend.
RUNWAY_BUDGET_PER_THREAD=5

# Runway API (Director's Canvas / video generation demo).
# Get a key: https://dev.runwayml.com → Dev Portal → API keys.
# When unset or "stub-...", the director runs in MOCK mode with deterministic
# placeholder image/video URLs so the canvas works end-to-end without burning
# credits. Flip to a real key to switch to live Gen-4 image+video generation.
RUNWAY_API_KEY=

# Runway Characters — Director avatar (optional).
# Create an avatar at dev.runwayml.com → Characters → Create a Character.
# Copy the avatar ID and paste it here. When unset, the avatar panel is hidden.
# This is a NEXT_PUBLIC_ var because it's read by the client to decide whether
# to show the panel — the actual API key is never sent to the client.
NEXT_PUBLIC_RUNWAY_AVATAR_ID=

# Notion integration (required for the lead-form demo)
# Get a token: https://notion.so/my-integrations → New integration → copy the
# "Internal Integration Token". Then SHARE the leads database with that
# integration (Notion's per-database access model — a fresh token sees zero
# databases until it's shared into them). The agent calls Notion through
# `npx @notionhq/notion-mcp-server`, so no global install is needed.
NOTION_TOKEN=

# Notion Leads database — the source of truth for the canvas.
# Paste the database ID from a Notion URL: https://notion.so/<workspace>/<dbid>?v=...
NOTION_LEADS_DATABASE_ID=

# Optional thread culler tuning
THREAD_STALE_HOURS=3
THREAD_CULL_BATCH_SIZE=1000

# Intelligence auth secrets — auto-generated by the Intelligence Docker stack.
# Copy from deployment/.env or the Intelligence admin panel.
INTELLIGENCE_AUTH_SECRET=
INTELLIGENCE_RUNNER_AUTH_SECRET=
INTELLIGENCE_SECRET_KEY_BASE=
