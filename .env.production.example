# ----------------------------------------------------------------------------
# Production environment — Hetzner VPS
# Copy to .env on the server: cp .env.production.example .env
# Never commit this file with real values.
# ----------------------------------------------------------------------------

# Your server's domain. Caddy uses this for automatic TLS.
# Must point to the server's IP before you deploy (A record).
DOMAIN=director.yourdomain.com

# --- App keys (required) ---

# Gemini Flash-Lite — the agent's LLM.
# Get a key: https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# Runway API — video generation. Leave blank for MOCK mode.
# Get a key: https://dev.runwayml.com → Dev Portal → API keys
RUNWAY_API_KEY=

# Runway Characters — Director avatar (optional but recommended for the demo).
# Create an avatar at dev.runwayml.com → Characters → Create a Character.
# NEXT_PUBLIC_ so the client knows whether to show the panel (key stays server-side).
NEXT_PUBLIC_RUNWAY_AVATAR_ID=

# CopilotKit license — run `npm run license` locally to get one.
COPILOTKIT_LICENSE_TOKEN=

# --- Intelligence secrets (generate strong random values) ---
# openssl rand -base64 32
INTELLIGENCE_AUTH_SECRET=
# openssl rand -base64 32
INTELLIGENCE_RUNNER_AUTH_SECRET=
# openssl rand -base64 64
INTELLIGENCE_SECRET_KEY_BASE=

# Intelligence API key — the seed value works for single-server deploys.
# Replace with a real key if you run Intelligence separately.
INTELLIGENCE_API_KEY=cpk_sPRVSEED_seed0privat0longtoken00

# --- Optional ---

# Notion integration (for the /leads demo)
NOTION_TOKEN=
NOTION_LEADS_DATABASE_ID=

# Anthropic key (only if AGENT_RUNTIME=claude-sonnet-4-6-react)
ANTHROPIC_API_KEY=

# Agent runtime (default: gemini-flash-deep)
AGENT_RUNTIME=gemini-flash-deep

# Per-thread Runway call budget when using the shared server key.
# Default 20 calls ≈ 10 shots × (1 image + 1 video).
RUNWAY_BUDGET_PER_THREAD=20

# Thread retention
THREAD_STALE_HOURS=72
THREAD_CULL_BATCH_SIZE=1000
