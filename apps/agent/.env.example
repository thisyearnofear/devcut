# ----------------------------------------------------------------------------
# apps/agent/.env — read by `langgraph dev` from this directory.
# Quickest: symlink root env — ln -sf ../../.env .env
# Planner: docs/providers.md
# ----------------------------------------------------------------------------

NVIDIA_API_KEY=
VENICE_API_KEY=
GEMINI_API_KEY=stub-replace-with-real-key-from-aistudio-google-com
AGENT_RUNTIME=nvidia-react

# Notion (leads demo only)
NOTION_TOKEN=
NOTION_LEADS_DATABASE_ID=

GENBLAZE_ENABLED=0
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=us-west-004
RUNWAY_API_KEY=
